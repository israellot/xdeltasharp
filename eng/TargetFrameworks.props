<Project>
  <!-- ProjectReference consumers can restore with their application's SDK.
       The repository's pinned SDK builds every target for release packages. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(NETCoreAppMaximumVersion)' &gt;= '9.0'">$(TargetFrameworks);net9.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(NETCoreAppMaximumVersion)' &gt;= '10.0'">$(TargetFrameworks);net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(NETCoreAppMaximumVersion)' &gt;= '11.0'">$(TargetFrameworks);net11.0</TargetFrameworks>
  </PropertyGroup>
</Project>
