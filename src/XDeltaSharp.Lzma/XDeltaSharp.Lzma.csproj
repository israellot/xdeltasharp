<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>xdelta.Lzma</PackageId>
    <RepositoryUrl>https://github.com/israellot/xdeltasharp</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>XDeltaSharp decoding with managed support for xdelta3 LZMA secondary compression.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../XDeltaSharp/XDeltaSharp.csproj" />
    <PackageReference Include="SharpCompress" Version="0.50.12" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
