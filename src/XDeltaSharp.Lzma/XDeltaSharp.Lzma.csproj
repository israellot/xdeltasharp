<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/TargetFrameworks.props" />
  <PropertyGroup>
    <PackageId>xdelta.Lzma</PackageId>
    <Title>XDeltaSharp LZMA decoder</Title>
    <Description>Apply xdelta3 VCDIFF patches with LZMA secondary compression in .NET 8. Decode mixed raw and compressed sections across windows to an array, span, or stream.</Description>
    <PackageTags>vcdiff;xdelta;xdelta3;lzma;lzma2;binary-patch</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../XDeltaSharp/XDeltaSharp.csproj" />
    <PackageReference Include="SharpCompress" Version="0.50.12" />
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
