<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <VersionPrefix>3.0.0</VersionPrefix>
    <PackageReleaseNotes>Breaking: settings moved from optional parameters to options objects. Pass a VcdiffEncodeOptions (CompressionLevel, MemoryMode, Optimize) to Vcdiff.Encode and a VcdiffDecodeOptions (MaxOutputBytes, MaxWindowBytes, MaxEncodedWindowBytes, Armor) to Vcdiff.Decode. LzmaVcdiff.Decode takes an LzmaDecodeOptions, which adds MaxExpandedSectionBytes and MaxDictionaryBytes. DecodeWithLimits and DecodeWithSecondaryLimits are removed. Patch bytes are unchanged.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Israel Lot</Authors>
    <RepositoryUrl>https://github.com/israellot/xdeltasharp</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
