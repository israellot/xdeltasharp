+    private int FindSlot(ReadOnlySpan<byte> data)
+    {
+        int mask = BucketCount - 1;
+        int slot = Bucket(data, mask);
+        ulong key = BinaryPrimitives.ReadUInt64LittleEndian(data);
+        while (true)
+        {
