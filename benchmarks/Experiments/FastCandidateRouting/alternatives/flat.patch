+    private CopyMatch FlatSearch(ReadOnlySpan<byte> window, int probe, int pending, int bucket)
+    {
+        int start = _flat![bucket];
+        int length = Math.Min(257, _flat[bucket + 1] - start);
+        var group = _flat.AsSpan(_bucketCount + 1 + start, length);
+        int first = window[probe];
+        int i = 0;
+        CopyMatch best = default;
+        for (; i <= length - 4; i += 4)
+        {
+            var words = Vector128.LoadUnsafe(ref group[i]);
+            uint lanes = Vector128.Equals(words >>> 24, Vector128.Create(first)).ExtractMostSignificantBits();
+            while (lanes != 0)
+            {
+                int lane = BitOperations.TrailingZeroCount(lanes);
+                int pos = (group[i + lane] & 0xffffff) * 8;
+                if (CanBeat(window, probe, pending, pos, best.Length))
+                {
+                    var match = Extend(window, probe, pending, pos);
+                    if (match.Length > best.Length) best = match;
+                    if (best.Length == window.Length - pending) return best;
+                }
+                lanes &= lanes - 1;
+            }
+        }
+        for (; i < length; i++)
+        {
+            int word = group[i];
+            if ((word >>> 24) != first) continue;
+            int pos = (word & 0xffffff) * 8;
+            if (!CanBeat(window, probe, pending, pos, best.Length)) continue;
+            var match = Extend(window, probe, pending, pos);
+            if (match.Length > best.Length) best = match;
+            if (best.Length == window.Length - pending) break;
+        }
+        return best;
+    }
