+    private static int ContextClasses(ReadOnlySpan<byte> bytes, int p, int floor)
+    {
+        int forward = (bytes[p] ^ (bytes[p + 1] >> 2) ^ bytes[p + 2]) & 3;
+        int classes = 1 << (24 + forward);
+        if (p - floor >= 2)
+        {
+            int backward = (bytes[p] ^ (bytes[p - 1] >> 2) ^ bytes[p - 2]) & 3;
+            classes |= 1 << (28 + backward);
+        }
+        return classes;
+    }
