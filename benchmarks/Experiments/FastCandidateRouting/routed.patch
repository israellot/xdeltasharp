+using System.Buffers;
+using System.Runtime.Intrinsics;
+
+namespace VCDiffSharp.Encoding;
+
+// Direct-mapped working set of repeatedly visited chain tails. Slots cover only original ordinals 16..256.
+internal sealed class HotRoutes : IDisposable
+{
+    private const int Slots = 32, Width = 256;
+    private int[]? _keys, _counts, _positions;
+    private byte[]? _bytes;
+
+    public int Get(int bucket, int entry, in MatchIndex index, ReadOnlySpan<byte> source)
+    {
+        if (_keys == null)
+        {
+            _keys = ArrayPool<int>.Shared.Rent(Slots);
+            _keys.AsSpan(0, Slots).Clear();
+            _counts = ArrayPool<int>.Shared.Rent(Slots);
+        }
+        int slot = bucket & (Slots - 1), key = bucket + 1;
+        if (_keys[slot] != key)
+        {
+            _keys[slot] = key;
+            _counts![slot] = 0;
+            return -1;
+        }
+        if (_counts![slot] != 0) return slot;
+        _positions ??= ArrayPool<int>.Shared.Rent(Slots * Width);
+        _bytes ??= ArrayPool<byte>.Shared.Rent(5 * Slots * Width);
+        int n = 0, start = slot * Width;
+        while (entry != 0 && n < 241)
+        {
+            int pos = (entry - 1) * 8, i = start + n;
+            _positions[i] = pos;
+            _bytes[i] = source[pos];
+            _bytes[Slots * Width + i] = source[pos + 4];
+            _bytes[2 * Slots * Width + i] = pos + 8 < source.Length ? source[pos + 8] : (byte)0;
+            _bytes[3 * Slots * Width + i] = pos > 0 ? source[pos - 1] : (byte)0;
+            _bytes[4 * Slots * Width + i] = pos >= 2 ? source[pos - 2] : (byte)0;
+            n++;
+            entry = index.Entry(index.BucketCount + entry - 1);
+        }
+        _counts[slot] = n;
+        return slot;
+    }
+    public int Count(int slot) => _counts![slot];
+    public int Position(int slot, int i) => _positions![slot * Width + i];
+
+    // A mismatch at +ahead limits forward length to ahead. To win, the remainder
+    // must therefore match to the left of the probe. Combine both necessary conditions.
+    public uint Mask(int slot, int offset, ReadOnlySpan<byte> window, int probe, int pending, int best)
+    {
+        int i = slot * Width + offset;
+        ref byte b = ref _bytes![i];
+        var mask = Vector128.Equals(Vector128.LoadUnsafe(ref b), Vector128.Create(window[probe]));
+        if (best >= 4)
+        {
+            int ahead = best >= 8 ? 8 : 4;
+            int lane = ahead == 8 ? 2 : 1;
+            var right = window.Length - probe > ahead ?
+                Vector128.Equals(Vector128.LoadUnsafe(ref b, (nuint)(lane * Slots * Width)), Vector128.Create(window[probe + ahead])) : Vector128<byte>.Zero;
+            if (probe - pending > best - ahead)
+            {
+                var left = Vector128.Equals(Vector128.LoadUnsafe(ref b, (nuint)(3 * Slots * Width)), Vector128.Create(window[probe - 1]));
+                if (best > ahead)
+                    left &= Vector128.Equals(Vector128.LoadUnsafe(ref b, (nuint)(4 * Slots * Width)), Vector128.Create(window[probe - 2]));
+                right |= left;
+            }
+            mask &= right;
+        }
+        int remain = Count(slot) - offset;
+        uint bits = mask.ExtractMostSignificantBits();
+        return remain < 16 ? bits & ((1u << remain) - 1) : bits;
+    }
+    public void Dispose()
+    {
+        if (_keys != null) ArrayPool<int>.Shared.Return(_keys);
+        if (_counts != null) ArrayPool<int>.Shared.Return(_counts);
+        if (_positions != null) ArrayPool<int>.Shared.Return(_positions);
+        if (_bytes != null) ArrayPool<byte>.Shared.Return(_bytes);
+    }
+}
