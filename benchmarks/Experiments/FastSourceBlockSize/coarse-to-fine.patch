+                writer.Copy(anchor.ReadOffset, anchor.Length);
+                delta = anchor.ReadOffset-anchor.WriteOffset;
+                floor = probe = anchor.End;
+            }
+            return writer.Finish(window,start==0,destination);
+        }
+        finally { writer.Dispose(); }
+    }
