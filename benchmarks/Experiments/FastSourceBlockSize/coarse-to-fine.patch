+using System.Buffers.Binary;
+using System.Numerics;
+
+namespace VCDiffSharp.Encoding;
+
+// Experimental 32-byte landmarks, using the same seed hash as the full-width block-size benchmark.
+internal readonly ref struct CoarseMatches
+{
+    private readonly ReadOnlySpan<byte> _source;
+    private readonly MatchIndex _index;
+    internal CoarseMatches(ReadOnlySpan<byte> source, MemoryMode memory, Span<byte> scratch)
+    {
+        _source = source;
+        int blocks = source.Length / 32;
+        _index = new MatchIndex(blocks, MatchIndex.Buckets(blocks, memory), scratch);
+        for (int block = blocks - 1; block >= 0; block--)
+            _index.Prepend(Bucket(source[(block * 32)..]), block);
+    }
+
+    private int Bucket(ReadOnlySpan<byte> data)
+    {
+        ulong x = BinaryPrimitives.ReadUInt64LittleEndian(data);
+        for (int offset = 8; offset < 32; offset += 8)
+            x = BitOperations.RotateLeft(x, 19) ^ BinaryPrimitives.ReadUInt64LittleEndian(data[offset..]);
+        unchecked
+        {
+            x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9UL;
+            x = (x ^ (x >> 27)) * 0x94d049bb133111ebUL;
+            return (int)(x ^ (x >> 31)) & (_index.BucketCount - 1);
+        }
+    }
+
+    internal CopyMatch Find(ReadOnlySpan<byte> target, int probe, int floor, int minimum)
+    {
+        var tail = target[probe..];
+        int entry = _index.Entry(Bucket(tail));
+        CopyMatch best = default;
+        for (int hops = 0; entry != 0; hops++)
+        {
+            int block = entry - 1;
+            int pos = block * 32;
+            var candidate = _source[pos..];
+            if (tail[..32].SequenceEqual(candidate[..32]))
+            {
+                int forward = 32 + tail[32..].CommonPrefixLength(candidate[32..]);
+                int back = 0, limit = Math.Min(pos, probe - floor);
+                while (back < limit && target[probe-back-1] == _source[pos-back-1]) back++;
+                int length = forward + back;
+                if (length >= minimum && length > best.Length)
+                {
+                    best = new CopyMatch(pos-back, probe-back, length);
+                    if (length == target.Length - floor) break;
+                }
+            }
+            if (hops == 256) break;
+            entry = _index.Entry(_index.BucketCount + block);
+        }
+        return best;
+    }
+
+    public void Dispose() => _index.Dispose();
+}
