+    private static byte[]? CascadeWindow(scoped in CoarseMatches coarse, ReadOnlySpan<byte> segment,
+        int offset, ReadOnlySpan<byte> window, int start, Span<byte> fineScratch, ref SourceMatchFinder fine,
+        ref bool indexed, MemoryMode memory, IBufferWriter<byte>? destination)
+    {
+        Span<int> same = window.Length >= 128 && segment.Length >= 128 ? stackalloc int[768] : [];
+        var writer = new WindowWriter(offset, segment.Length, stackalloc byte[128],
+            stackalloc byte[64], stackalloc byte[64], same);
+        int floor = 0, probe = 0, delta = start-offset;
+        bool lazy = false, sampled = false;
+        try
+        {
+            while (floor < window.Length)
+            {
+                CopyMatch anchor = default;
+                while (probe <= window.Length-32)
+                {
+                    anchor = coarse.Find(window, probe, floor, AnchorMinimum);
+                    if (anchor.Length != 0) break;
+                    probe += CoarseProbeStep;
+                }
+                int end = anchor.Length == 0 ? window.Length : anchor.WriteOffset;
+                var gap = window[floor..end];
+                if (gap.Length >= 8)
+                {
+                    if (!indexed)
+                    {
+                        fine = new SourceMatchFinder(segment, window.Length, memory, fineScratch);
+                        indexed = true;
+                    }
+                    if (!sampled)
